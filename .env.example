# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Public client credentials (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supports either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Server-only credentials (NEVER expose to client / browser bundle, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-id.supabase.co
# Supports either SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
